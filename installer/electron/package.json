{
  "name": "run",
  "version": "1.0.0",
  "description": "Run Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.run.desktop",
    "productName": "Run",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "backend.jar",
        "to": "backend.jar"
      },
      {
        "from": "jre",
        "to": "jre"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "../../frontend/public/favicon.ico"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
